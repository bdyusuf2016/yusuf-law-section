# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ========================================================
# Production Database Configuration (PostgreSQL / Supabase)
# ========================================================
PORT=5000
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=revenue_cases_db
DB_SSL=false

# Or single DATABASE_URL connection string:
# DATABASE_URL=postgresql://postgres:password@localhost:5432/revenue_cases_db
